<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.AMoveTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/amove_background</item>
        <item name="colorPrimaryDark">@color/amove_background</item>
        <item name="colorAccent">@color/amove_accent</item>
        <item name="android:colorBackground">@color/amove_background</item>
        <item name="android:windowBackground">@color/amove_background</item>
        <item name="android:statusBarColor">@color/amove_background</item>
        <item name="android:navigationBarColor">@color/amove_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme" parent="Base.AMoveTheme" />

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <style name="Base.AMoveLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/amove_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/amove_background</item>
        <item name="android:navigationBarColor">@color/amove_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Base.AMoveLaunch" />
</resources>
