{
  "name": "@a-move-ago/tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "content:import": "tsx src/content-import.ts",
    "content:private": "tsx src/private-content.ts",
    "dev:seed": "tsx src/seed-local.ts",
    "render:wrangler": "tsx src/render-wrangler-config.ts",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate-content": "tsx src/validate-content.ts ../content/samples",
    "write:worker-secrets": "tsx src/write-worker-secrets.ts"
  },
  "dependencies": {
    "@a-move-ago/api-contract": "0.0.0",
    "@a-move-ago/game-core": "0.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
